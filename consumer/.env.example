# Copie da tela do lab depois de clicar em "Ligar fila"
RABBITMQ_URL=amqp://company_xxx:senha@IP_PUBLICO_DO_RABBIT:5672
QUEUE=company.xxx

# Opcional: simula processamento lento (ms por mensagem)
PROCESSING_MS=0

# Opcional: mensagens entregues sem ack ao mesmo tempo (padrão 10)
PREFETCH=10

# Opcional: MODE=stats mostra um resumo por segundo (use no teste de carga)
MODE=
