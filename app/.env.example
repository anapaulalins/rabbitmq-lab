# IP PRIVADO da EC2 do RabbitMQ (ex.: 172.31.10.20). A API fala com o Rabbit
# por dentro da VPC, sem passar pela internet.
RABBITMQ_URL=amqp://admin:troque-esta-senha@IP_PRIVADO_DO_RABBIT:5672
RABBITMQ_MANAGEMENT_URL=http://IP_PRIVADO_DO_RABBIT:15672
RABBITMQ_MANAGEMENT_USER=admin
RABBITMQ_MANAGEMENT_PASSWORD=troque-esta-senha

# Endereço que o CLIENTE usa (vai nas credenciais mostradas na tela).
# Etapa 1 (sem TLS): amqp://IP_PUBLICO_DO_RABBIT:5672
# Etapa 2 (com TLS): amqps://SEU_DOMINIO:5671
RABBITMQ_PUBLIC_URL=amqp://IP_PUBLICO_DO_RABBIT:5672

RABBITMQ_EXCHANGE=lab.events
PORT=3000
